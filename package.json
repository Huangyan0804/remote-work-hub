{
	"name": "my-turborepo",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "biome check --write --unsafe --config-path=biome.beautify.json",
		"format:staged": "biome check --write --unsafe --config-path=biome.beautify.json --staged",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"husky": "^9.1.7",
		"turbo": "^2.10.12",
		"typescript": "5.9.2"
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=18"
	}
}
